<Window x:Class="eLog.Views.Windows.Dialogs.AiChatWindow" chrome:WindowChromeTheme.Enabled="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chrome="clr-namespace:libeLog.Infrastructure;assembly=libeLog"
        xmlns:vm="clr-namespace:eLog.ViewModels"
        xmlns:ctrl="clr-namespace:eLog.Views.Controls"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AiChatViewModel}"
        Title="ДОЗОР — помощник оператора" Height="700" Width="620" MinHeight="480" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Areopag.FontUI}" FontSize="15"
        Background="{DynamicResource Areopag.Bg0}">
    <Window.DataContext>
        <vm:AiChatViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Лента сообщений -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Areopag.Line}" BorderThickness="1"
                Background="{DynamicResource Areopag.Bg1}" CornerRadius="6">
            <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="6">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0 3">
                                <!-- Вопрос оператора — справа -->
                                <Border CornerRadius="8" Padding="8 6" MaxWidth="480"
                                        HorizontalAlignment="Right"
                                        Background="{DynamicResource Areopag.AccentSoft}"
                                        Visibility="{Binding IsUser, Converter={StaticResource VisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm}}"
                                                   FontSize="11" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Areopag.Text3}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Ответ помощника — глаз Дозора + облако слева -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" MaxWidth="560"
                                        Visibility="{Binding IsUser, Converter={StaticResource InvertedVisibilityConverter}}">
                                    <!-- Живой глаз: в покое статичен, пока думает —
                                         зрачок краснеет и пульсирует -->
                                    <ctrl:DozorEye Width="26" Height="26" Margin="0 2 6 0"
                                                   VerticalAlignment="Top" Focusable="False"
                                                   IsBusy="{Binding IsThinking}"/>
                                    <Border CornerRadius="8" Padding="8 6" MaxWidth="520"
                                        Background="{DynamicResource Areopag.Input}"
                                        BorderBrush="{DynamicResource Areopag.Line}" BorderThickness="1">
                                    <StackPanel>
                                        <!-- Пока ответа нет — виден шаг работы, а не пустое облако -->
                                        <TextBlock Text="{Binding Activity}" FontStyle="Italic"
                                                   Foreground="{DynamicResource Areopag.Text2}"
                                                   Visibility="{Binding IsThinking, Converter={StaticResource VisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Areopag.Alert}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Источники — отдельно, свёрнуты: блок короче ответа -->
                                        <Expander Header="{Binding SourcesHeader}" IsExpanded="False"
                                                  FontSize="12" Margin="0 4 0 0"
                                                  Foreground="{DynamicResource Areopag.Text2}"
                                                  Visibility="{Binding HasSources, Converter={StaticResource VisibilityConverter}}">
                                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Sources}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="0 2" TextWrapping="Wrap" ToolTip="{Binding Snippet}">
                                                                <Hyperlink NavigateUri="{Binding Url}">
                                                                    <Run Text="{Binding Title}"/>
                                                                </Hyperlink>
                                                                <LineBreak/>
                                                                <Run Text="{Binding Url}" FontSize="11"
                                                                     Foreground="{DynamicResource Areopag.Text3}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Expander>
                                        <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm}}"
                                                   FontSize="11" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource Areopag.Text3}"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Статус (очередь к GPU, поиск в сети) -->
        <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="4 4 4 0" FontSize="13"
                   Foreground="{DynamicResource Areopag.Text2}" TextWrapping="Wrap"/>

        <!-- Ввод: Enter — отправить, Shift+Enter — новая строка -->
        <Grid Grid.Row="2" Margin="0 6 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="InputBox" Grid.Column="0" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MaxLines="4" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" Padding="8" MinHeight="60"
                         PreviewKeyDown="InputBox_PreviewKeyDown"/>
                <!-- Подсказка поверх пустого поля -->
                <TextBlock Text="Спросите про смену, деталь, простой…" Margin="12 9 0 0"
                           VerticalAlignment="Top" IsHitTestVisible="False"
                           Foreground="{DynamicResource Areopag.Text3}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="6 0 0 0">
                <Button Content="Отправить" Padding="16 8" Style="{StaticResource Areopag.PrimaryButton}"
                        Command="{Binding SendCommand}" IsDefault="True"/>
                <Button Content="Стоп" Padding="16 8" Margin="0 6 0 0" Style="{StaticResource GeneralButton}"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding CanCancel, Converter={StaticResource VisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- Низ: очистка. Сеть включается фразой в самом вопросе («поищи в сети»),
             вопросы о работе программы — из инструкции. -->
        <DockPanel Grid.Row="3" Margin="0 6 0 0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Очистить" Padding="12 4"
                    Style="{StaticResource GeneralButton}" Command="{Binding ClearCommand}"/>
        </DockPanel>
    </Grid>
</Window>
