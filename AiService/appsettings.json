{
  "Port": 5050,
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen3:14b"
  },
  "RequestLog": {
    "Enabled": true,
    "Directory": "request_logs"
  },
  "Chat": {
    "SystemPromptFile": "chat_system.txt",
    "Temperature": 0.2,
    "Thinking": true,
    "MaxHistoryMessages": 20,
    "MaxContextChars": 12000,
    "AgentMaxIterations": 4,
    "AgentTimeoutSeconds": 180
  },
  "WebSearch": {
    "Enabled": true,
    "Provider": "searxng",
    "BaseUrl": "http://localhost:8888",
    "TimeoutSeconds": 10,
    "MaxResults": 5,
    "AllowDomains": []
  },
  "Docs": {
    "Directory": "docs"
  },
  "Stock": {
    "File": "docs/stock.csv"
  },
  "Agent": {
    "Enabled": true,
    "MaxIterations": 4,
    "TimeoutSeconds": 180,
    "Temperature": 0.0,
    "Thinking": "auto",
    "VerifyFalse": false,
    "VerifyTemperature": 0.7,
    "VerifyRounds": 2,
    "HistoryMaxRecords": 5,
    "HistoryMaxDaysBack": 720
  },
  "Database": {
    "ConnectionString": "${CNCJ_RO_CONSTR}",
    "CommandTimeoutSeconds": 15,
    "MaxRows": 200
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "AiService.Program": "Debug",
      "AiService.Services.OllamaService": "Debug",
      "AiService.Controllers.AnalysisController": "Debug",
      "AiService.Services.ChatAgentService": "Information",
      "AiService.Controllers.ChatController": "Information"
    }
  }
}
