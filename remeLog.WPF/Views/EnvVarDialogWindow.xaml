<Window x:Class="remeLog.Views.EnvVarDialogWindow" chrome:WindowChromeTheme.Enabled="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:libeLog.Infrastructure;assembly=libeLog"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Переменная окружения"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow" Loaded="Window_Loaded"
        Background="{DynamicResource Areopag.Bg0}">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource Areopag.TextBox}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="10" MinWidth="340">
        <!-- Имя: только по маске. Пока не по маске — поле подсвечено, кнопка ОК недоступна. -->
        <TextBlock Text="Имя (латиница, цифры, _; первый символ — не цифра):"
                   TextWrapping="Wrap"/>
        <Grid Margin="0 2 0 0">
            <TextBox x:Name="NameBox"
                     Text="{Binding VariableName, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
            <TextBlock Text="например NOTIFY_SMTP_PWD">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Areopag.FieldHint}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <!-- Значение произвольное: может содержать «=», пробелы, кавычки. -->
        <TextBlock Text="Значение:" Margin="0 8 0 0"/>
        <Grid Margin="0 2 0 0">
            <TextBox x:Name="ValueBox"
                     Text="{Binding VariableValue, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="например secret123">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Areopag.FieldHint}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=ValueBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button Content="Отмена" Width="75" IsCancel="True"/>
            <Button Content="OK" Width="75" Margin="10 0 0 0" IsDefault="True"
                    Click="Ok_Click"
                    IsEnabled="{Binding (Validation.HasError), ElementName=NameBox, Converter={StaticResource InvertedBoolConverter}}"
                    Style="{StaticResource Areopag.PrimaryButton}" FontFamily="{DynamicResource Areopag.FontMono}"/>
        </StackPanel>
    </StackPanel>
</Window>
