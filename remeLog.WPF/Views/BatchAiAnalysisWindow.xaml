<Window x:Class="remeLog.Views.BatchAiAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:remeLog.ViewModels"
        mc:Ignorable="d" WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow" WindowState="Maximized" ResizeMode="CanResize"
        d:DataContext="{d:DesignInstance Type=vm:BatchAiAnalysisViewModel}"
        Title="Пакетный ИИ-анализ суток" Height="600" Width="900">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" HorizontalContentAlignment="Stretch">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock Text="{Binding StatusText}" FontSize="14" Margin="0 -1"/>
            </StatusBarItem>
        </StatusBar>
        <ProgressBar DockPanel.Dock="Bottom"
                     Height="3"
                     Minimum="0" Maximum="1"
                     Value="{Binding OverallProgress, Mode=OneWay}"/>

        <DockPanel DockPanel.Dock="Top" Margin="6">
            <Button DockPanel.Dock="Right"
                    Content="Запустить"
                    Width="110" Margin="6 0 0 0"
                    FontSize="14"
                    Command="{Binding StartCommand}"/>
            <Button DockPanel.Dock="Right"
                    Content="Остановить"
                    Width="110" Margin="6 0 0 0"
                    FontSize="14"
                    Command="{Binding CancelCommand}"/>
            <Button DockPanel.Dock="Right"
                    Content="Обновить список"
                    Width="130" Margin="6 0 0 0"
                    FontSize="14"
                    Command="{Binding RefreshCommand}"/>
            <CheckBox Content="Только непроверенные"
                      VerticalAlignment="Center"
                      FontSize="14" Margin="0 0 8 0"
                      IsChecked="{Binding OnlyPending}"/>
            <CheckBox Content="Размышления ИИ"
                      VerticalAlignment="Center"
                      FontSize="14" Margin="0 0 8 0"
                      IsChecked="{Binding ThinkingEnabled}"
                      ToolTip="Включить режим рассуждений модели. Медленнее, но видны мысли."/>
            <TextBlock VerticalAlignment="Center" FontSize="14">
                <Run Text="Обработано:"/>
                <Run Text="{Binding ProcessedCount, Mode=OneWay}"/>
                <Run Text="/"/>
                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
            </TextBlock>
        </DockPanel>

        <ListView ItemsSource="{Binding Items}"
                  FontSize="14"
                  BorderThickness="0 1 0 0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="2"/>
                    <Setter Property="BorderBrush" Value="#E5E5E5"/>
                    <Setter Property="BorderThickness" Value="0 0 0 1"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10"
                                         Margin="0 0 6 0"
                                         Fill="{Binding StateBrush}"/>
                                <TextBlock Text="{Binding Header}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Expander.Header>
                        <Grid Margin="12 4 4 4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </Grid.Resources>
                            <DockPanel Grid.Column="0" Margin="0 0 4 0">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Размышления ИИ"
                                           FontSize="11" Foreground="Gray"
                                           Margin="0 0 0 2"/>
                                <ScrollViewer MaxHeight="160"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding ThinkingThoughts}"
                                               FontSize="11" FontFamily="Consolas"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </DockPanel>
                            <Border Grid.Column="1" Background="#EEE" Width="1"/>
                            <DockPanel Grid.Column="2" Margin="4 0 0 0">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Объяснение"
                                           FontSize="11" Foreground="Gray"
                                           Margin="0 0 0 2"/>
                                <ScrollViewer MaxHeight="160"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding Explanation}"
                                               FontSize="13" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</Window>
