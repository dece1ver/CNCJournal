<Window x:Class="remeLog.Views.AiVerdictDialogWindow" chrome:WindowChromeTheme.Enabled="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:chrome="clr-namespace:libeLog.Infrastructure;assembly=libeLog"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:remeLog.Views"
        Title="{Binding Title, RelativeSource={RelativeSource Self}}"
        SizeToContent="Height" Width="640" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource Areopag.Bg0}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- Контент: растёт до 560, дальше скролл. Кнопки в Auto-строке место получают всегда -->
            <RowDefinition Height="*" MaxHeight="560"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
        <!-- Вердикт: иконка Дозора + заголовок -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ContentControl Content="{StaticResource DozorIcon.Themed}"
                            Width="24" Height="24" Margin="0 0 8 0"
                            VerticalAlignment="Center" Focusable="False"/>
            <TextBlock Text="{Binding VerdictTitle}" d:Text="Всё в порядке"
                       FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                       Foreground="{Binding VerdictBrush}"/>
        </StackPanel>
        <TextBlock Text="{Binding VerdictDetails}" d:Text="Уверенность 85%"
                   Opacity="0.7" Margin="0 2 0 12" TextWrapping="Wrap"/>

        <!-- Данные: общий вывод в заголовке, ниже объяснение и причины -->
        <TextBlock FontWeight="SemiBold" Margin="0 0 0 4">
            <Run Text="Данные — "/><Run Text="{Binding DataVerdictText}" Foreground="{Binding DataVerdictBrush}"/>
        </TextBlock>
        <Border BorderThickness="1" BorderBrush="{DynamicResource Areopag.Line}"
                Padding="8" Margin="0 0 0 10">
            <TextBlock Text="{Binding Explanation}" d:Text="Объяснение ИИ..."
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Перечисление признаков после блока объяснений — просто списком, без рамки -->
        <ItemsControl ItemsSource="{Binding Signals}" Margin="8 0 0 10"
                      Visibility="{Binding HasSignals, Converter={StaticResource VisibilityConverter}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0 1"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Суточный отчёт: общий вывод в заголовке, ниже сводка и причины -->
        <StackPanel Margin="0 0 0 10">
            <TextBlock FontWeight="SemiBold" Margin="0 0 0 4">
                <Run Text="Суточный отчёт — "/><Run Text="{Binding ShiftVerdictText}" Foreground="{Binding ShiftVerdictBrush}"/>
            </TextBlock>
            <Border Padding="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShiftCausedEscalation}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Warn}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding ShiftReportSummary}" Margin="8 0 0 4"
                                      Visibility="{Binding HasShiftReportSummary, Converter={StaticResource VisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0 1"
                                               Opacity="0.85" FontSize="12"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding ShiftReportIssues}" Margin="8 0 0 0"
                                      Visibility="{Binding HasShiftReportIssues, Converter={StaticResource VisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0 1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
            </Border>
        </StackPanel>

        <!-- Кандидаты на исключение из К1 -->
        <StackPanel Visibility="{Binding HasCandidates, Converter={StaticResource VisibilityConverter}}">
            <TextBlock Text="Исключение из расчёта К1" FontWeight="SemiBold" Margin="0 0 0 2"/>
            <TextBlock Text="Отметьте записи, в которых не виноват оператор — они не попадут в расчёт."
                       Opacity="0.7" FontSize="11" Margin="0 0 0 4" TextWrapping="Wrap"/>
            <Border BorderThickness="1" BorderBrush="{DynamicResource Areopag.Line}"
                    Padding="6" Margin="0 0 0 6">
                <ItemsControl ItemsSource="{Binding Candidates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding IsMatched}"
                                      Margin="0 2" VerticalContentAlignment="Top">
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Text="{Binding UnmatchedText}" TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0 0 0 6"
                       Visibility="{Binding HasUnmatched, Converter={StaticResource VisibilityConverter}}"/>
        </StackPanel>

        <!-- Строки, которые ИИ отметит проблемными при эскалации -->
        <TextBlock Text="{Binding FlaggedPreviewText}" TextWrapping="Wrap" FontSize="12" Margin="0 0 0 6"
                   Visibility="{Binding HasFlaggedPreview, Converter={StaticResource VisibilityConverter}}"/>

        <!-- Предупреждение (перезапись / результат не сохранён / строки вручную) -->
        <TextBlock Text="{Binding DayStatusHint}" TextWrapping="Wrap" Opacity="0.8" FontSize="11" Margin="0 0 0 6"
                   Visibility="{Binding HasDayStatusHint, Converter={StaticResource VisibilityConverter}}"/>

        <!-- Отзыв -->
        <TextBlock Text="Отзыв на результат ИИ" FontWeight="SemiBold" Margin="0 4 0 2"/>
        <TextBlock Text="Обязателен для кнопки «Не согласен», иначе — по желанию. Уточнение уйдёт в обучение."
                   Opacity="0.7" FontSize="11" Margin="0 0 0 4"/>
        <TextBox Text="{Binding Feedback, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="120"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Действия: фиксированная строка внизу, видна всегда -->
        <StackPanel Grid.Row="1">
        <!-- Отмена — крестик/Escape, отдельной кнопки нет -->
        <Button Content="Только исключить из К1" Margin="0 10 0 0" Padding="0 6"
                Click="ExcludesOnly_Click"
                ToolTip="Применить отмеченные исключения, статус дня не менять"
                Visibility="{Binding ShowExcludesOnly, Converter={StaticResource VisibilityConverter}}"/>
        <Grid Margin="0 10 0 0"
              Visibility="{Binding PrimaryActionVisible, Converter={StaticResource VisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{Binding OppositeActionText}" Padding="0 6" Margin="0 0 5 0"
                    Click="Opposite_Click"
                    ToolTip="{Binding OppositeActionTooltip}"
                    IsEnabled="{Binding OppositeEnabled}"
                    Style="{StaticResource Areopag.DangerButton}" FontFamily="{DynamicResource Areopag.FontMono}"/>
            <Button Grid.Column="1" Content="{Binding PrimaryActionText}" Padding="0 6" Margin="5 0 0 0" IsDefault="True"
                    Click="Primary_Click"
                    ToolTip="{Binding PrimaryActionTooltip}"
                    Style="{StaticResource Areopag.OkButton}" FontFamily="{DynamicResource Areopag.FontMono}"/>
        </Grid>
        </StackPanel>
    </Grid>
</Window>
