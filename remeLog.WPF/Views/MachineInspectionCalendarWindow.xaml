<Window x:Class="remeLog.Views.MachineInspectionCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:remeLog.ViewModels"
        Title="{Binding PeriodTitle}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="600" MinHeight="400"
        Background="White">
    <Window.Resources>
        <!-- Стиль ячейки даты — без рамки, простой текст -->
        <Style x:Key="DateCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2 0 0 0"/>
            <Setter Property="Foreground" Value="#303030"/>
            <Setter Property="ToolTip" Value="{Binding DayOfWeekShort}"/>
        </Style>

        <!-- Шаблон ячейки станка — иконка статуса -->
        <DataTemplate x:Key="MachineCellTemplate">
            <ContentControl Width="16" Height="16"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- Стиль ячейки % — центрированный текст -->
        <Style x:Key="PercentCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#303030"/>
            <Setter Property="ToolTip" Value="{Binding CheckedPercent}"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" FontSize="14" FontFamily="Consolas"
                   Foreground="#303030" Margin="0 0 0 4"
                   Text="{Binding Statistics}"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 4">
            <TextBlock Text="От:" VerticalAlignment="Center" FontFamily="Consolas"
                       FontSize="14" Foreground="#303030" Margin="0 0 4 0"/>
            <DatePicker SelectedDate="{Binding FromDate}" Width="120"
                        FontFamily="Consolas" FontSize="14" Margin="0 0 12 0"/>
            <TextBlock Text="До:" VerticalAlignment="Center" FontFamily="Consolas"
                       FontSize="14" Foreground="#303030" Margin="8 0 4 0"/>
            <DatePicker SelectedDate="{Binding ToDate}" Width="120"
                        FontFamily="Consolas" FontSize="14"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 4">
            <TextBlock Text="Месяц:" VerticalAlignment="Center" FontFamily="Consolas"
                       FontSize="14" Foreground="#303030" Margin="0 0 4 0"/>
            <ComboBox ItemsSource="{Binding AvailableMonths}"
                      SelectedValue="{Binding SelectedMonth}"
                      SelectedValuePath="Value" DisplayMemberPath="Name"
                      FontFamily="Consolas" FontSize="14" Width="97" Margin="0 0 12 0"/>
            <TextBlock Text="Год:" VerticalAlignment="Center" FontFamily="Consolas"
                       FontSize="14" Foreground="#303030" Margin="0 0 4 0"/>
            <ComboBox ItemsSource="{Binding AvailableYears}"
                      SelectedItem="{Binding SelectedYear}"
                      FontFamily="Consolas" FontSize="14" Width="120"/>
        </StackPanel>

        <ComboBox DockPanel.Dock="Top" IsEditable="True" IsReadOnly="True" Focusable="False"
                  Text="Выбор станков" HorizontalAlignment="Left" Margin="0 0 0 6"
                  ItemsSource="{Binding MachineFilters}" Width="314"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ComboBox.Style>
                <Style TargetType="ComboBox">
                    <Style.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="Text" Value=""/>
                        </Trigger>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter Property="Text" Value="Выбор станков"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.Style>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="-1" Focusable="False">
                        <CheckBox Content="{Binding Machine}" IsChecked="{Binding Filter}"/>
                    </Grid>
                </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Выбрать все" Command="{Binding ShowAllMachinesCommand}"/>
                    <MenuItem Header="Снять все" Command="{Binding HideAllMachinesCommand}"/>
                    <MenuItem Header="Инвертировать" Command="{Binding InvertMachinesCommand}"/>
                </ContextMenu>
            </ComboBox.ContextMenu>
        </ComboBox>

        <!-- DataGrid -->
        <DataGrid x:Name="CalendarGrid"
                  ItemsSource="{Binding Days}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeRows="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#E0E0E0"
                  VerticalGridLinesBrush="#E0E0E0"
                  HeadersVisibility="All"
                  FrozenColumnCount="1"
                  AlternatingRowBackground="#01D3D3D3"
                  BorderThickness="1"
                  BorderBrush="Gray"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  RowHeaderWidth="24"
                  SelectionUnit="CellOrRowHeader"
                  Background="White">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D9F3E8"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#303030"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D9F3E8"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#303030"/>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    <Setter Property="BorderThickness" Value="0 0 1 1"/>
                    <Setter Property="Foreground" Value="#303030"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="4 2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           SnapsToDevicePixels="True"
                                           Width="70" Margin="0 5"
                                           VerticalAlignment="Center" TextAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="270"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>
        </DataGrid>
    </DockPanel>
</Window>
