<Window x:Class="remeLog.Views.MachineInspectionCalendarWindow" chrome:WindowChromeTheme.Enabled="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:chrome="clr-namespace:libeLog.Infrastructure;assembly=libeLog"
        xmlns:vm="clr-namespace:remeLog.ViewModels"
        xmlns:controls="clr-namespace:remeLog.Views.Controls"
        Title="{Binding PeriodTitle}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="600" MinHeight="400"
        Background="{DynamicResource Areopag.Bg0}">
    <Window.Resources>
        <!-- Стиль ячейки даты — без рамки, простой текст -->
        <Style x:Key="DateCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource Areopag.FontMono}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2 0 0 0"/>
            <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
            <Setter Property="ToolTip" Value="{Binding DayOfWeekShort}"/>
        </Style>

        <!-- Шаблон ячейки станка (иконка статуса). Один шаблон на все колонки:
             имя станка берётся из заголовка колонки (DataGridCell.Column.Header).
             Сами колонки станков создаются в code-behind — они динамические,
             по одной на каждый выбранный станок (см. RebuildColumns). -->
        <DataTemplate x:Key="MachineCellTemplate">
            <ContentControl Width="16" Height="16" Margin="0 1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl.Content>
                    <MultiBinding Converter="{StaticResource MachineInspectionCalendarCellIconMultiConverter}">
                        <Binding/>
                        <Binding Path="Column.Header" RelativeSource="{RelativeSource AncestorType=DataGridCell}"/>
                    </MultiBinding>
                </ContentControl.Content>
            </ContentControl>
        </DataTemplate>

        <!-- Стиль ячейки % — текст по правому краю, заголовок центрирует свой стиль -->
        <Style x:Key="PercentCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontFamily" Value="{StaticResource Areopag.FontMono}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="4 0"/>
            <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
            <Setter Property="ToolTip" Value="{Binding CheckedPercent}"/>
        </Style>
    </Window.Resources>
    <!-- Верхние контролы — ровной сеткой: метки и поля выровнены по колонкам
         (SharedSizeGroup), стили те же, что в PartsInfoWindow. -->
    <Grid Margin="8" Grid.IsSharedSizeScope="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="CalLabel"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="CalControl"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="CalLabel"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="CalControl"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="5" FontSize="14" FontFamily="{StaticResource Areopag.FontMono}"
                   Foreground="{DynamicResource Areopag.Text}" Margin="0 0 0 4"
                   Text="{Binding Statistics}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="От:" VerticalAlignment="Center"
                   HorizontalAlignment="Right" FontFamily="{StaticResource Areopag.FontMono}"
                   FontSize="14" Foreground="{DynamicResource Areopag.Text}" Margin="0 0 4 4"/>
        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding FromDate}" Width="130"
                    FontFamily="{StaticResource Areopag.FontMono}" FontSize="14" Margin="0 0 0 4"
                    BorderThickness="0" Style="{StaticResource DatePickerOutlineStyle}"
                    CalendarStyle="{StaticResource Areopag.CalendarStyle}"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="До:" VerticalAlignment="Center"
                   HorizontalAlignment="Right" FontFamily="{StaticResource Areopag.FontMono}"
                   FontSize="14" Foreground="{DynamicResource Areopag.Text}" Margin="16 0 4 4"/>
        <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding ToDate}" Width="130"
                    FontFamily="{StaticResource Areopag.FontMono}" FontSize="14" Margin="0 0 0 4"
                    BorderThickness="0" Style="{StaticResource DatePickerOutlineStyle}"
                    CalendarStyle="{StaticResource Areopag.CalendarStyle}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Месяц:" VerticalAlignment="Center"
                   HorizontalAlignment="Right" FontFamily="{StaticResource Areopag.FontMono}"
                   FontSize="14" Foreground="{DynamicResource Areopag.Text}" Margin="0 0 4 4"/>
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableMonths}"
                  SelectedValue="{Binding SelectedMonth}"
                  SelectedValuePath="Value" DisplayMemberPath="Name"
                  FontFamily="{StaticResource Areopag.FontMono}" FontSize="14" Width="130" Margin="0 0 0 4"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="Год:" VerticalAlignment="Center"
                   HorizontalAlignment="Right" FontFamily="{StaticResource Areopag.FontMono}"
                   FontSize="14" Foreground="{DynamicResource Areopag.Text}" Margin="16 0 4 4"/>
        <ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding AvailableYears}"
                  SelectedItem="{Binding SelectedYear}"
                  FontFamily="{StaticResource Areopag.FontMono}" FontSize="14" Width="130" Margin="0 0 0 4"/>

        <!-- Фильтр по станкам — общий контрол (Views/Controls/MachineFilterSelector.xaml) -->
        <controls:MachineFilterSelector Grid.Row="3" Grid.ColumnSpan="5" HorizontalAlignment="Left"
                                        Margin="0 0 0 6" Width="184"
                                        ItemsSource="{Binding MachineFilters}"
                                        Summary="{Binding MachineFilterSummary}"
                                        ShowAllCommand="{Binding ShowAllMachinesCommand}"
                                        HideAllCommand="{Binding HideAllMachinesCommand}"
                                        InvertCommand="{Binding InvertMachinesCommand}"/>

        <!-- DataGrid -->
        <DataGrid x:Name="CalendarGrid" Grid.Row="4" Grid.ColumnSpan="5"
                  ItemsSource="{Binding Days}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeRows="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource Areopag.LineSoft}"
                  VerticalGridLinesBrush="{DynamicResource Areopag.LineSoft}"
                  HeadersVisibility="All"
                  FrozenColumnCount="1"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Areopag.Line}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  RowHeaderWidth="24"
                  SelectionUnit="CellOrRowHeader"
                  Background="{DynamicResource Areopag.Bg1}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding DateDisplay}" Width="100"
                                    ElementStyle="{StaticResource DateCellStyle}"/>
                <!-- Колонки станков здесь НЕ объявлены: они динамические и
                     добавляются из code-behind (MachineInspectionCalendarWindow.xaml.cs,
                     RebuildColumns) между «Дата» и «Проверено». -->
                <!-- Ширина с запасом: текст вида «12/14 — 085.7%» (~108px) +
                     горизонтальный отступ текста (PercentCellStyle.Margin). -->
                <DataGridTextColumn Header="Проверено" Binding="{Binding CheckedPercent}" Width="130"
                                    ElementStyle="{StaticResource PercentCellStyle}"/>
            </DataGrid.Columns>
            <DataGrid.Resources>
                <!-- Подсветка выбранных ячеек — как у строк глобально (AccentSoft/Text).
                     Через Color-ключи палитры: DynamicResource на Color валиден и переключается с темой -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource Areopag.AccentSoftColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource Areopag.TextColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource Areopag.AccentSoftColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource Areopag.TextColor}"/>
                <!-- Фон/рамка/шрифт/шаблон — из глобального Areopag.DataGridColumnHeader; здесь только кегль/отступы/поворот -->
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Areopag.DataGridColumnHeader}">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="4 2"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           SnapsToDevicePixels="True"
                                           Width="70" Margin="0 5"
                                           VerticalAlignment="Center" TextAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="270"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>
        </DataGrid>
    </Grid>
</Window>
