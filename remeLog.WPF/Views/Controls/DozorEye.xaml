<UserControl x:Class="remeLog.Views.Controls.DozorEye"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="16" d:DesignHeight="16">
    <!-- Живой глаз-Дозор. Геометрия — та же точная, что у DozorIcon.Themed
         в libeLog/Icons.xaml (фирменный знак + зрачок cx=500 cy=278.292 r=86).
         Состояния задаются снаружи через флаги, вся анимация живёт здесь:
         покой — статичен; думает — пульс зрачка; агент — зрачок осматривается;
         вердикт в покое — цвет зрачка; недоступен — приглушён. -->
    <Grid x:Name="Layout" Width="20" Height="20" Background="Transparent">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Canvas Width="1000" Height="556">
                <!-- Фирменный знак -->
                <Path x:Name="Mark" Fill="{DynamicResource Areopag.IconGrey}"
                      SnapsToDevicePixels="False"
                      Data="m 549.24807,488.15923 c 95.09396,-6.07189 178.78345,-26.38096 247.98763,-60.17958 13.03356,-6.36546 42.12401,-23.02887 44.69985,-25.6047 0.54945,-0.54941 -4.38585,0.46795 -10.9671,2.2608 -64.23744,17.4992 -144.61919,29.36083 -239.34627,35.31946 -30.19033,1.89906 -152.39615,1.91826 -182.23444,0.0286 -96.24476,-6.0951 -177.35577,-18.136 -242.24517,-35.9612 -11.52819,-3.1668 -11.16127,-2.7244 6.45733,7.78584 70.01781,41.76855 163.50918,68.16047 268.27072,75.73083 24.96339,1.80392 83.53821,2.14209 107.37745,0.61992 z M 599.32998,372.1091 c 110.01798,-7.81027 195.39055,-23.64073 262.61579,-48.69632 42.08855,-15.68685 64.88261,-32.7083 62.96326,-47.01779 -4.08998,-30.49303 -111.46955,-67.84897 -242.44491,-84.34334 -145.07597,-18.27014 -317.5874,-13.16167 -444.90962,13.17481 -80.14906,16.57876 -143.84084,41.63965 -158.26981,62.27463 -6.478374,9.26477 -4.795244,17.39476 5.617665,27.13481 9.870566,9.23275 23.353045,16.75199 46.665735,26.02565 73.26584,29.14477 180.4928,47.83154 306.44863,53.40575 24.33732,1.07704 137.99221,-0.30262 161.31326,-1.9582 z M 182.45938,148.37167 c 182.1073,-45.75854 456.25606,-45.69045 636.5187,0.15808 10.30874,2.62195 19.73417,5.09395 20.9454,5.49331 8.90031,2.93457 -22.34525,-15.76439 -44.04458,-26.35854 C 637.72334,50.44887 395.98944,46.048245 227.15331,117.31119 c -21.15546,8.92936 -58.41381,28.83908 -66.61742,35.59828 -2.07739,1.71161 -2.08299,1.77629 -0.0988,1.14086 1.15689,-0.37048 11.06692,-2.92588 22.02228,-5.67866 z m 283.0852,407.39877 C 318.80344,548.98727 190.65527,511.19478 104.42626,449.27214 83.406579,434.17754 57.593088,410.23404 44.283191,393.486 7.7354645,347.49744 -6.3784218,296.33828 3.7289056,246.48723 28.798186,122.8412 191.59195,26.383872 412.52548,4.2701686 444.07593,1.1122165 473.50682,0.10080984 515.64528,0.726419 c 41.3015,0.6131776 63.3207,2.0461569 97.44863,6.3418135 C 806.75857,31.444638 955.14916,117.1955 991.20118,225.56605 c 6.22218,18.70378 8.19042,31.05452 8.24713,51.75238 0.0595,21.63137 -2.20333,35.72519 -8.79042,54.75595 -40.61978,117.3561 -207.54123,204.98858 -422.15911,221.63032 -20.75955,1.60972 -84.95478,2.89777 -102.9542,2.06574 z">
                    <Path.Style>
                    <Style TargetType="Path">
                        <Style.Triggers>
                            <!-- Недоступен: овалы приглушить (зрачок при этом скрыт, см. стиль Pupil) -->
                            <DataTrigger Binding="{Binding IsAvailable, ElementName=Root}" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </DataTrigger>
                        </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <!-- Зрачок: в покое синий как на кнопках (Primary), в работе красный (см. триггеры) -->
                <Ellipse x:Name="Pupil" Canvas.Left="414" Canvas.Top="192.292" Width="172" Height="172"
                         StrokeThickness="0"
                         SnapsToDevicePixels="True">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform CenterX="500" CenterY="278.292"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <!-- База здесь (сеттер стиля), а не атрибутом: иначе local value
                             перекроет Fill из триггеров ниже и зрачок не будет краснеть -->
                        <Setter Property="Fill" Value="{DynamicResource Areopag.Primary}"/>
                        <Style.Triggers>
                            <!-- Недоступен: зрачок убрать совсем -->
                            <DataTrigger Binding="{Binding IsAvailable, ElementName=Root}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <!-- Обычные размышления: зрачок краснеет и пульсирует -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsBusy, ElementName=Root}" Value="True"/>
                                    <Condition Binding="{Binding IsAgent, ElementName=Root}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Fill" Value="{DynamicResource Areopag.IconRed}"/>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="ThinkingPulse">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                 From="1" To="1.35"
                                                                 Duration="0:0:1.4" AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                 From="1" To="1.35"
                                                                 Duration="0:0:1.4" AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                    <MultiDataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="ThinkingPulse"/>
                                    </MultiDataTrigger.ExitActions>
                                </MultiDataTrigger>
                            <!-- Агент ходит за данными: зрачок краснеет и осматривается по сторонам -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsBusy, ElementName=Root}" Value="True"/>
                                    <Condition Binding="{Binding IsAgent, ElementName=Root}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Fill" Value="{DynamicResource Areopag.IconRed}"/>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="AgentLook">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                                 From="-130" To="130"
                                                                 Duration="0:0:1.8" AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.2"
                                                                 Duration="0:0:0.7" AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                    <MultiDataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="AgentLook"/>
                                    </MultiDataTrigger.ExitActions>
                                </MultiDataTrigger>
                                <!-- Вердикты в покое: цвет зрачка -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBusy, ElementName=Root}" Value="False"/>
                                        <Condition Binding="{Binding HasResult, ElementName=Root}" Value="True"/>
                                        <Condition Binding="{Binding HasError, ElementName=Root}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Fill" Value="{DynamicResource Areopag.Alert}"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBusy, ElementName=Root}" Value="False"/>
                                        <Condition Binding="{Binding HasResult, ElementName=Root}" Value="True"/>
                                        <Condition Binding="{Binding HasError, ElementName=Root}" Value="False"/>
                                        <Condition Binding="{Binding RequiresReview, ElementName=Root}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Fill" Value="{DynamicResource Areopag.Warn}"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBusy, ElementName=Root}" Value="False"/>
                                        <Condition Binding="{Binding HasResult, ElementName=Root}" Value="True"/>
                                        <Condition Binding="{Binding HasError, ElementName=Root}" Value="False"/>
                                        <Condition Binding="{Binding RequiresReview, ElementName=Root}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Fill" Value="{DynamicResource Areopag.Ok}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
