<Window x:Class="remeLog.Views.PartnameDialogWindow" chrome:WindowChromeTheme.Enabled="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:chrome="clr-namespace:libeLog.Infrastructure;assembly=libeLog"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Деталь" 
        Height="200" 
        Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Areopag.Bg0}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource Areopag.Button}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontFamily" Value="{DynamicResource Areopag.FontMono}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Наименование:" Grid.Row="0"/>
        <TextBox x:Name="InputTextBox" 
                 d:Text="Корпус клапана АР110-01-001 (под азотацию 666-100500 HRc)"
                 Grid.Row="1" 
                 TextAlignment="Center" 
                 TextWrapping="Wrap" 
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,10"
                 Text="{Binding PartName, UpdateSourceTrigger=PropertyChanged}"/>

        <DockPanel Grid.Row="2">
            <TextBlock Text="Количество заказов:" Grid.Row="2"/>
            <TextBox x:Name="OrderCountTextBox"
         TextAlignment="Center"
         VerticalContentAlignment="Center"
         Margin="5,0,0,10"
         Text="{Binding OrderCount, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <UniformGrid Columns="2" Grid.Row="4">
            <Button Content="Отмена" 
                    IsCancel="True"
                    HorizontalAlignment="Left"/>
            <Button Content="OK" 
                    IsDefault="True"
                    Click="OkButton_Click"
                    HorizontalAlignment="Right"
                    IsEnabled="{Binding IsInputValid}"
                    Style="{StaticResource Areopag.PrimaryButton}" FontFamily="{DynamicResource Areopag.FontMono}"/>
        </UniformGrid>
    </Grid>
</Window>