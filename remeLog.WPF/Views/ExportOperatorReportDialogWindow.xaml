<Window x:Class="remeLog.Views.ExportOperatorReportDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:remeLog.Views"
        WindowStartupLocation="CenterOwner"
        xmlns:vm="clr-namespace:remeLog.ViewModels"
        mc:Ignorable="d"
        Title="Параметры отчета" Height="160" Width="300">
    <Window.DataContext>
        <vm:ExportOperatorDailogWindowViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" >
            <CheckBox Margin="-1 5 0 0" Content="Включить штучные партии" IsChecked="{Binding IncludeSmallBatch}"
                      ToolTip="Штучная партия: м/в &lt; 3 мин и ≤ 10 шт, либо м/в ≥ 3 мин и ≤ 5 шт.&#10;Без галочки изготовление считается без штучных."/>
            <CheckBox Margin="-1 5 0 0" Content="Только серийная продукция" IsChecked="{Binding OnlySerialParts}"/>
            <CheckBox Margin="-1 5 0 0" Content="Включить исключённые" IsChecked="{Binding IncludeExcludedlParts}"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Grid.Column="0" Columns="2">
            <Button Content="Отмена" IsCancel="True" Margin="0 0 5 0" VerticalAlignment="Bottom" Height="26"/>
            <Button Content="Экспорт" IsDefault="True" Margin="5 0 0 0" VerticalAlignment="Bottom" Height="26"
                    Command="{Binding ExportCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=local:ExportOperatorReportDialogWindow}}">
            </Button>
        </UniformGrid>
    </Grid>
</Window>
