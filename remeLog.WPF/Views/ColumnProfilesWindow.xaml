<Window x:Class="remeLog.Views.ColumnProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:remeLog.Views"
        xmlns:cmd="clr-namespace:remeLog.Infrastructure.Commands"
        xmlns:vm="clr-namespace:remeLog.ViewModels" d:DataContext="{d:DesignInstance Type=vm:ColumnProfilesWindowViewModel}"
        mc:Ignorable="d"
        Title="Профили столбцов" Height="500" Width="600" WindowStartupLocation="CenterOwner">
    <Window.DataContext>
        <vm:ColumnProfilesWindowViewModel />
    </Window.DataContext>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0" Grid.Row="0">
            <UniformGrid DockPanel.Dock="Bottom" Rows="1" Columns="3" Margin="0 4 0 0">
                <Button Content="+" FontWeight="Bold" Margin="0 0 2 0" ToolTip="Добавить профиль" Command="{Binding AddProfileCommand}"/>
                <Button Content="✎" Margin="2 0" ToolTip="Переименовать профиль" Command="{Binding RenameProfileCommand}"/>
                <Button Content="✕" Margin="2 0 0 0" ToolTip="Удалить профиль" Command="{Binding DeleteProfileCommand}"/>
            </UniformGrid>
            <ListBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name"
                     SelectedItem="{Binding SelectedProfile}"/>
        </DockPanel>

        <GroupBox Grid.Column="2" Grid.Row="0" Header="Видимые колонки">
            <DockPanel>
                <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="4" Margin="0 0 0 4">
                    <Button Content="Выбрать всё" Margin="0 0 2 0" Command="{Binding SelectAllColumnsCommand}"/>
                    <Button Content="Снять всё" Margin="2 0" Command="{Binding DeselectAllColumnsCommand}"/>
                    <Button Content="Технолог" Margin="2 0" ToolTip="Взять за основу набор колонок роли «Технолог»"
                            Command="{Binding ApplyRolePresetCommand}" CommandParameter="Engineer"/>
                    <Button Content="Мастер" Margin="2 0 0 0" ToolTip="Взять за основу набор колонок роли «Мастер»"
                            Command="{Binding ApplyRolePresetCommand}" CommandParameter="Master"/>
                </UniformGrid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Ширина столбца, px" VerticalAlignment="Center" HorizontalContentAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0 8 0 0">
            <Button Content="Ok" Width="100" Margin="0 0 5 0"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=local:ColumnProfilesWindow}}">
                <Button.Command>
                    <cmd:CloseDialogCommand DialogResult="True"/>
                </Button.Command>
            </Button>
            <Button Content="Отмена" Width="100"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=local:ColumnProfilesWindow}}">
                <Button.Command>
                    <cmd:CloseDialogCommand DialogResult="False"/>
                </Button.Command>
            </Button>
        </StackPanel>
    </Grid>
</Window>
