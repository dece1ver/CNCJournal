<Window x:Class="remeLog.Views.MultiValueEditorWindow" chrome:WindowChromeTheme.Enabled="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:chrome="clr-namespace:libeLog.Infrastructure;assembly=libeLog"
        Title="Выбор значений"
        Height="340" Width="420"
        MinHeight="260" MinWidth="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Areopag.Bg0}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Название поля -->
            <RowDefinition Height="Auto"/>
            <!-- Ввод -->
            <RowDefinition Height="*"/>
            <!-- Чипы -->
            <RowDefinition Height="Auto"/>
            <!-- Подсказка -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- Название поля -->
        <TextBlock Grid.Row="0"
                   x:Name="FieldNameText"
                   FontWeight="SemiBold" FontSize="13"
                   Margin="2 2 2 6"/>

        <!-- Ввод -->
        <DockPanel Grid.Row="1" Margin="0 0 0 4">
            <Button DockPanel.Dock="Right"
                    Content="Добавить"
                    Width="72" Margin="4 0 0 0"
                    Click="Add_Click"/>
            <Grid>
                <TextBox x:Name="InputBox"
                         Height="22"
                         VerticalContentAlignment="Center"
                         KeyDown="InputBox_KeyDown"
                         TextChanged="InputBox_TextChanged"/>
                <TextBlock x:Name="Placeholder"
                           Text="Введите значение…"
                           Foreground="{DynamicResource Areopag.Text3}" FontSize="12"
                           Margin="4 0 0 0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </DockPanel>

        <!-- Область чипов -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Areopag.Line}"
                BorderThickness="1"
                Margin="0 0 0 4">
            <Grid>

                <!-- Пустое состояние -->
                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="Нет значений"
                               Foreground="{DynamicResource Areopag.Text3}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Введите значение выше или вставьте через ;"
                               FontSize="11" Foreground="{DynamicResource Areopag.Text3}"
                               HorizontalAlignment="Center"
                               Margin="0 3 0 0"/>
                </StackPanel>

                <!-- Чипы -->
                <ScrollViewer x:Name="ChipsScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="4">
                    <ItemsControl ItemsSource="{Binding Values}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Areopag.AccentSoft}"
                                        BorderBrush="{DynamicResource Areopag.Line}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        Margin="2" Padding="5 2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Value}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="200"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Value}"/>
                                        <Button Content="×"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Width="14" Height="14"
                                                Padding="0"
                                                Margin="4 0 0 0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                Click="ChipRemove_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- Подсказка -->
        <TextBlock Grid.Row="3"
                   FontSize="9" Foreground="{DynamicResource Areopag.Text3}"
                   Margin="0 0 0 6">
            <Run Text="Enter"/>
            <Run Text=" — добавить  ·  "/>
            <Run Text="Ctrl+V"/>
            <Run Text=" — вставить несколько (разделитель "/>
            <Run FontFamily="{StaticResource Areopag.FontMono}" Text=";"/>
            <Run Text=" или перенос строки)"/>
        </TextBlock>

        <!-- Кнопки -->
        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Left"
                    Content="Очистить"
                    Width="72"
                    Click="ClearAll_Click"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Width="72"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button x:Name="OkButton"
                        Content="Применить"
                        Width="72" Margin="4 0 0 0"
                        IsDefault="True"
                        Click="OK_Click"
                        Style="{StaticResource Areopag.PrimaryButton}" FontFamily="{DynamicResource Areopag.FontMono}"/>
            </StackPanel>
        </DockPanel>

    </Grid>
</Window>
