<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================================
         remeLog.WPF — неявные (без x:Key) тематические стили.
         Подключается в App.xaml ПОСЛЕ StyleDictionary.
         Все ссылки на палитру — DynamicResource, поэтому переключение
         темы через ThemeManager применяется мгновенно, без перезапуска.
         Шрифты: кнопки — Areopag.FontMono; остальное НЕ трогаем
         (размеры подогнаны под текущие шрифты).
         eLog этот словарь НЕ подключает и не меняется.
         ============================================================ -->

    <!-- remeLog использует системный Segoe UI вместо корпоративного Golos:
         перекрываем ключ FontUI на уровне словаря remeLog (палитра задаёт
         Golos, его оставляет за собой eLog). Ключ Areopag.FontSegoe тоже
         доступен, если нужен Segoe явно. -->
    <FontFamily x:Key="Areopag.FontUI">Segoe UI</FontFamily>

    <!-- Весь текст по умолчанию — Areopag.Text.
         Системный хром со своим фоном (тултипы, табы, заголовки
         колонок, пункты меню) переопределён ниже. -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
    </Style>

    <!-- Поля ввода. Ключ Areopag.TextBox — чтобы inline-стили в окнах
         могли быть BasedOn (иначе стиль заменяется целиком и фон остаётся
         системно-белым — так ловили баг в редакторе серийных деталей). -->
    <Style x:Key="Areopag.TextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Areopag.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Areopag.DisabledBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Areopag.DisabledFg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Disabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource Areopag.TextBox}"/>

    <!-- Текстовая часть DatePicker: явный минимальный шаблон, чтобы не зависеть
         от системного (у него свои захардкоженные цвета внутренностей). -->
    <Style TargetType="{x:Type DatePickerTextBox}">
        <!-- Даты в пикерах — моноширинным -->
        <Setter Property="FontFamily" Value="{DynamicResource Areopag.FontMono}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Areopag.AccentSoft}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <!-- Фон прозрачный: заливает общий фон самого DatePicker.
                         Центрирование — через VerticalContentAlignment. -->
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Календарь в попапах DatePicker: системный белый с наследованным светлым
         текстом давал «белое на белом». Свои цвета + простые шаблоны кнопок. -->
    <Style TargetType="{x:Type Calendar}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Areopag.CalendarItemStyle" TargetType="{x:Type CalendarItem}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Шаблон — копия системного: вся геометрия/части (PART_*) 1:1,
             заменены только захардкоженные цвета (стрелки #333, заголовок,
             внутренняя белая рамка, белая вуаль disabled). -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarItem}">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type CalendarItem}, ResourceId=DayTitleTemplate}">
                            <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="9.5"
                                       Foreground="{DynamicResource Areopag.Text}"
                                       Margin="0 6 0 6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0" SnapsToDevicePixels="True">
                            <Border BorderBrush="{DynamicResource Areopag.LineSoft}"
                                    BorderThickness="1" CornerRadius="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Button x:Name="PART_PreviousButton" Width="28" Height="20"
                                            HorizontalAlignment="Left" Focusable="False"
                                            Grid.Column="0" Grid.Row="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Grid Background="Transparent" Cursor="Hand">
                                                    <Path Data="M288.75,232.25L288.75,240.625 283,236.625z"
                                                          Stretch="Fill" Fill="{DynamicResource Areopag.Text}"
                                                          Width="6" Height="10" Margin="14,-6,0,0"
                                                          HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="PART_HeaderButton" FontSize="10.5" FontWeight="Bold"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Focusable="False" Grid.Column="1" Grid.Row="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Grid Background="Transparent" Cursor="Hand">
                                                    <ContentPresenter Content="{TemplateBinding ContentControl.Content}"
                                                                      ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                                                                      Margin="1 4 1 9"
                                                                      HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                                                                      TextElement.Foreground="{DynamicResource Areopag.Text}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="PART_NextButton" Width="28" Height="20"
                                            HorizontalAlignment="Right" Focusable="False"
                                            Grid.Column="2" Grid.Row="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Grid Background="Transparent" Cursor="Hand">
                                                    <Path Data="M282.875,231.875L282.875,240.375 288.625,236z"
                                                          Stretch="Fill" Fill="{DynamicResource Areopag.Text}"
                                                          Width="6" Height="10" Margin="0,-6,14,0"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Grid x:Name="PART_MonthView" Grid.Row="1" Grid.ColumnSpan="3"
                                          Margin="6,-1,6,6" HorizontalAlignment="Center" Visibility="Visible">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                    </Grid>
                                    <Grid x:Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="3"
                                          Margin="6,-3,7,6" HorizontalAlignment="Center" Visibility="Hidden">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>
                        <Rectangle x:Name="PART_DisabledVisual" RadiusX="0" RadiusY="0" Stretch="Fill"
                                   Fill="{DynamicResource Areopag.DisabledVeil}"
                                   Stroke="{DynamicResource Areopag.DisabledVeil}" StrokeThickness="1"
                                   Opacity="0" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Areopag.CalendarDayButtonStyle" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <ControlTemplate.Resources>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Areopag.ButtonContentText}"/>
                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="5 1" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Areopag.ButtonContentText}"/>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Areopag.OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Areopag.Text3}"/>
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Areopag.DisabledFg}"/>
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Areopag.DisabledFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Areopag.CalendarButtonStyle" TargetType="{x:Type CalendarButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <ControlTemplate.Resources>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Areopag.ButtonContentText}"/>
                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="8 6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Areopag.ButtonContentText}"/>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Areopag.OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Areopag.Text3}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Areopag.DisabledFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль календаря целиком: ставится ЯВНО на каждый DatePicker
         (CalendarStyle) и каждый отдельный Calendar — везёт за собой
         кнопки дней/месяцев, фон и рамки. -->
    <Style x:Key="Areopag.CalendarStyle" TargetType="{x:Type Calendar}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource Areopag.CalendarDayButtonStyle}"/>
        <Setter Property="CalendarButtonStyle" Value="{StaticResource Areopag.CalendarButtonStyle}"/>
        <Setter Property="CalendarItemStyle" Value="{StaticResource Areopag.CalendarItemStyle}"/>
    </Style>

    <!-- Кнопки: база Areopag.Button + шрифт Mono слоем remeLog.
         Размеры (Width/Height/FontSize/Padding/Margin) НЕ заданы —
         остаются на местах использования. -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Areopag.Button}">
        <Setter Property="FontFamily" Value="{DynamicResource Areopag.FontMono}"/>
    </Style>

    <!-- Тумблеры (пикер даты и т.п.): база + Mono. -->
    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource Areopag.ToggleButton}">
        <Setter Property="FontFamily" Value="{DynamicResource Areopag.FontMono}"/>
    </Style>

    <!-- Комбобоксы по умолчанию — канонный Areopag-стиль из StyleDictionary.
         Без рамки: иначе виден 1px-контур фона окна (единое правило remeLog,
         не задавать BorderThickness точечно в окнах). -->
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ComboBoxStyle}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Подсказка в пустом поле (TextBlock поверх поля). Показ — DataTrigger
         по пустому Text поля (пример — поля «начало»/«конец» в PartsInfoWindow). -->
    <Style x:Key="Areopag.FieldHint" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4 0 0 0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text3}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <!-- Кнопка-«комбобокс» (фильтр по станкам и т.п.): белый фон как у ComboBox,
         hover/открыто — AccentSoft. Используется MachineFilterSelector. -->
    <Style x:Key="Areopag.MachineFilterToggle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource Areopag.ToggleButton}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Input}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Areopag.AccentSoft}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Areopag.AccentSoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Списки -->
    <Style TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg0}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
    </Style>
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg0}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
    </Style>

    <!-- Дерево (серийные детали) -->
    <Style TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg0}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
    </Style>
    <Style TargetType="{x:Type TreeViewItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Areopag.AccentSoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Плоский шаблон ПРОСТОГО списка (без View/GridView): у системного
         триггер IsEnabled красит корень в белый поверх TemplateBinding.
         Только для списков без колонок — GridView-спискам он убьёт шапку. -->
    <ControlTemplate x:Key="Areopag.PlainListViewTemplate" TargetType="{x:Type ListView}">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="0" SnapsToDevicePixels="True">
            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
            </ScrollViewer>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Areopag.Bg0}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Таблицы -->
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Areopag.LineSoft}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Areopag.LineSoft}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <!-- Чередующийся фон строк — единое правило remeLog; окна его НЕ задают. -->
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Areopag.RowAlt}"/>
    </Style>
    <!-- С ключами — чтобы окна наследовали локальные стили строк/ячеек/шапок
         через BasedOn (без него локальный стиль заменяет глобальный целиком
         и теряет подсветку выбора/плоский шаблон). Ниже — неявные twins. -->
    <Style x:Key="Areopag.DataGridRow" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Areopag.AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource Areopag.DataGridRow}"/>
    <Style x:Key="Areopag.DataGridCell" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Areopag.AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource Areopag.DataGridCell}"/>
    <Style x:Key="Areopag.DataGridColumnHeader" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.LineSoft}"/>
        <Setter Property="BorderThickness" Value="0 0 1 1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="4 3"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- Плоский шаблон вместо системного хрома (у того hover заливал
             ярко-синим). Грипперы PART_* обязательны — иначе сломается
             ресайз колонок. Стрелка сортировки рисуется триггерами. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <Path x:Name="SortArrow" Grid.Column="1"
                                      Fill="{DynamicResource Areopag.Text2}"
                                      Stretch="Uniform" Width="8" Height="8" Margin="4 0 0 0"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                               Width="6" Style="{DynamicResource Areopag.HeaderGripper}"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                               Width="6" Style="{DynamicResource Areopag.HeaderGripper}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.LineSoft}"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="Data" Value="{StaticResource UpArrow}"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="Data" Value="{StaticResource DownArrow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Грипперы ресайза колонок: полностью невидимы, но ловят мышь.
         Отдельный стиль обязателен: неявный глобальный Thumb рисует серую
         плашку с рамкой и hover-подсветкой — в шапках это даёт «странные
         области» по краям каждой колонки. Прозрачный фон хит-тест проходит. -->
    <Style x:Key="Areopag.HeaderGripper" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource Areopag.DataGridColumnHeader}"/>
    <Style TargetType="{x:Type DataGridRowHeader}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.LineSoft}"/>
    </Style>
    <Style TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.LineSoft}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0 0 1 1" Padding="4 3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right"
                               Margin="0 0 -9 0" Width="18" Style="{DynamicResource Areopag.HeaderGripper}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.LineSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Статусбар -->
    <Style TargetType="{x:Type StatusBar}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
    </Style>

    <!-- Прогрессбар: системный синий выбивался из тёмной.
         Дефолтный шаблон красит дорожку из Background, полосу из Foreground. -->
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
    </Style>

    <!-- Кнопка «выбрать всё» в углу DataGrid (над заголовками строк).
         У DataGrid нет свойства для неё — шаблон ищет стиль по системному
         компонентному ключу, его и переопределяем. -->
    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type DataGrid}, ResourceId=DataGridSelectAllButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.LineSoft}"/>
        <Setter Property="BorderThickness" Value="0 0 1 1"/>
        <Setter Property="FontFamily" Value="{DynamicResource Areopag.FontMono}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0" SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.LineSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вкладки -->
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg0}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
        <Setter Property="Padding" Value="10 4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1 1 1 0"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Areopag.Input}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Areopag.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Areopag.DisabledFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Меню: шапка — на фоне окна, дропдауны — Bg1 с подсветкой AccentSoft.
         Свой шаблон нужен, т.к. системный красит текст чёрным
         (в тёмной теме — чёрное на чёрном). -->
    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
    </Style>
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <!-- Свой шаблон: системный рисует колонку под иконки (серая полоса
             слева), а у нас иконок нет. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Areopag.MenuItemStyle" TargetType="{x:Type MenuItem}">
        <!-- Иконок нет: колонки под них тоже нет. Состояние выбора (тема,
             роль) показывает галочка в потоке заголовка — места не занимает,
             пока пункт не отмечен. -->
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True" Padding="13 4" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="ArrowCol" Width="0"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="{StaticResource Checkmark}"
                                      Fill="{DynamicResource Areopag.Text}"
                                      Stretch="Uniform" Width="11" Height="11"
                                      Margin="0 0 6 0" VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                                <ContentPresenter x:Name="HeaderHost" ContentSource="Header"
                                                  RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Path x:Name="Arrow" Grid.Column="1"
                                  Data="{StaticResource RightArrow}"
                                  Fill="{DynamicResource Areopag.Text}"
                                  Stretch="Uniform" Width="8" Height="8"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <Popup x:Name="SubmenuPopup" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Areopag.Bg1}"
                                        BorderBrush="{DynamicResource Areopag.Line}" BorderThickness="1"
                                        Padding="2" SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="500">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Горизонтальный отступ 13 — только у внутренних
                             пунктов. Верхнеуровневые (на панели меню) — 8. -->
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Root" Property="Padding" Value="8 4"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="Root" Property="Padding" Value="8 4"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="ArrowCol" Property="Width" Value="12"/>
                            <Setter TargetName="SubmenuPopup" Property="Placement" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Areopag.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Areopag.DisabledFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Неявный twin: подхватывается всеми пунктами без явного стиля.
         Явные стили (роли в PartsInfo, годы в контекст-меню) наследуются
         через BasedOn="{StaticResource Areopag.MenuItemStyle}". -->
    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource Areopag.MenuItemStyle}"/>

    <!-- Экспандеры (BatchAi, панель размышлений): плоский заголовок
         вместо системного хрома с синим hover. Только раскрытие вниз. -->
    <Style TargetType="{x:Type Expander}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" Focusable="False"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Background="Transparent" BorderThickness="0" Padding="4 2">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="0"
                                                      Data="{StaticResource RightArrow}"
                                                      Fill="{DynamicResource Areopag.Text2}"
                                                      Stretch="Uniform" Width="9" Height="9"
                                                      Margin="0 0 6 0" VerticalAlignment="Center"/>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="LayoutTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom"
                                              Visibility="Collapsed" Focusable="False"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Areopag.DisabledFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Подсказки -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource Areopag.Bg1}"/>
        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Скроллбары: плоские, в цветах темы (системные светло-серые
         выбивались из тёмной). Размеры системные, не заданы. -->
    <ControlTemplate x:Key="Areopag.VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <RepeatButton Grid.Row="0" Command="{x:Static ScrollBar.LineUpCommand}" Padding="3">
                <Path Data="{StaticResource UpArrow}" Fill="{DynamicResource Areopag.Text2}"
                      Stretch="Uniform" Width="9" Height="9"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </RepeatButton>
            <Track Grid.Row="1" x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"/>
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Command="{x:Static ScrollBar.LineDownCommand}" Padding="3">
                <Path Data="{StaticResource DownArrow}" Fill="{DynamicResource Areopag.Text2}"
                      Stretch="Uniform" Width="9" Height="9"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </RepeatButton>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="Areopag.HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <RepeatButton Grid.Column="0" Command="{x:Static ScrollBar.LineLeftCommand}" Padding="3">
                <Path Data="{StaticResource RightArrow}" Fill="{DynamicResource Areopag.Text2}"
                      Stretch="Uniform" Width="9" Height="9"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5 0.5">
                    <Path.RenderTransform>
                        <ScaleTransform ScaleX="-1"/>
                    </Path.RenderTransform>
                </Path>
            </RepeatButton>
            <Track Grid.Column="1" x:Name="PART_Track" Focusable="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"/>
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Column="2" Command="{x:Static ScrollBar.LineRightCommand}" Padding="3">
                <Path Data="{StaticResource RightArrow}" Fill="{DynamicResource Areopag.Text2}"
                      Stretch="Uniform" Width="9" Height="9"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </RepeatButton>
        </Grid>
    </ControlTemplate>
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template" Value="{StaticResource Areopag.VerticalScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource Areopag.HorizontalScrollBarTemplate}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="{DynamicResource Areopag.BtnBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0" SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.BtnHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.LineSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Areopag.DisabledBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Areopag.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Areopag.LineSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
