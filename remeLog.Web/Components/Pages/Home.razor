@page "/"
@rendermode InteractiveServer
@using remeLog.Core.Services
@using remeLog.Models

<PageTitle>Сводка по сменам · remeLog</PageTitle>

<div class="page-head">
    <h1>Сводка по сменам</h1>
    <span class="meta">@FromDate.ToString("dd.MM.yyyy") — @ToDate.ToString("dd.MM.yyyy")</span>
</div>

<div class="filters">
    <div class="filter-field">
        <label class="field-label" for="from">С</label>
        <input id="from" type="date" @bind="FromDate" />
    </div>
    <div class="filter-field">
        <label class="field-label" for="to">По</label>
        <input id="to" type="date" @bind="ToDate" />
    </div>
    <div class="filter-field">
        <span class="field-label">Сутки</span>
        <div class="day-nav">
            <button type="button" class="day-nav-btn" disabled="@_loading" @onclick="() => ShiftDaysAsync(-1)" title="Минус сутки">−</button>
            <button type="button" class="day-nav-btn" disabled="@_loading" @onclick="() => ShiftDaysAsync(1)" title="Плюс сутки">+</button>
        </div>
    </div>
    <button @onclick="LoadAsync" disabled="@_loading">Обновить</button>
</div>

@if (_loading)
{
    <p class="state-line">Загрузка…</p>
}
else if (_error is not null)
{
    <p class="state-line state-error">@_error</p>
}
else if (_rows is not null)
{
    @if (_rows.Count == 0)
    {
        <p class="state-line">Нет станков.</p>
    }
    else
    {
        <p class="table-caption">
            не работали: <strong>@_notWorkedCount</strong> из @_rows.Count
        </p>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Станок</th>
                        <th>Работал</th>
                        <th class="num">Смен за период</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _sortedRows)
                    {
                        <tr>
                            <td>@row.Machine</td>
                            <td><span class="stamp @StampClass(row.State)">@StateText(row.State)</span></td>
                            <td class="num">@_shiftsByMachine.GetValueOrDefault(row.Machine, 0)</td>
                            <td>
                                <a class="row-link"
                                   href="@($"/parts?machine={Uri.EscapeDataString(row.Machine)}&from={FromDate:yyyy-MM-dd}&to={ToDate:yyyy-MM-dd}")">
                                    детали →
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private DateTime FromDate = DateTime.Today.AddDays(-1);
    private DateTime ToDate = DateTime.Today.AddDays(-1);
    private bool _loading;
    private string? _error;
    private List<MainDashboardService.MachineReportState>? _rows;
    private List<MainDashboardService.MachineReportState> _sortedRows = new();
    private int _notWorkedCount;
    private Dictionary<string, int> _shiftsByMachine = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task ShiftDaysAsync(int days)
    {
        FromDate = FromDate.AddDays(days);
        ToDate = ToDate.AddDays(days);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();
        try
        {
            var reference = await MainDashboardService.LoadReferenceDataAsync(CancellationToken.None);
            if (!reference.Machines.IsOk)
            {
                _error = "Не удалось получить список станков.";
                return;
            }

            var machines = reference.Machines.Value ?? new List<string>();
            var overview = await MainDashboardService.LoadShiftOverviewAsync(machines, FromDate, ToDate, CancellationToken.None);
            _rows = overview.ReportStates;
            _shiftsByMachine = overview.TotalShifts
                .GroupBy(s => s.Machine)
                .ToDictionary(g => g.Key, g => g.Count());

            // Не работавшие станки — первым делом на виду, дальше частичные, рабочие — в конце.
            _sortedRows = _rows
                .OrderBy(r => r.State switch
                {
                    CombinedParts.ReportState.NotExist => 0,
                    CombinedParts.ReportState.Partial => 1,
                    _ => 2,
                })
                .ThenBy(r => r.Machine)
                .ToList();
            _notWorkedCount = _rows.Count(r => r.State == CombinedParts.ReportState.NotExist);
        }
        catch (Exception ex)
        {
            _error = $"Ошибка: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string StampClass(CombinedParts.ReportState state) => state switch
    {
        CombinedParts.ReportState.Exist => "stamp-ok",
        CombinedParts.ReportState.Partial => "stamp-warn",
        _ => "stamp-alert",
    };

    private static string StateText(CombinedParts.ReportState state) => state switch
    {
        CombinedParts.ReportState.Exist => "Да",
        CombinedParts.ReportState.Partial => "Частично",
        _ => "Нет",
    };
}
