<Window x:Class="libeLog.Views.MessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MinWidth="300" MaxWidth="480"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <DrawingBrush x:Key="IconError" Stretch="Uniform">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1Ac50b17" Geometry="F1M13.5,7.5a6,6,0,1,1-6-6A6,6,0,0,1,13.5,7.5Z"/>
                    <GeometryDrawing Brush="#FFc50b17" Geometry="F1M7.5,1A6.5,6.5,0,1,0,14,7.5,6.508,6.508,0,0,0,7.5,1Zm0,12A5.5,5.5,0,1,1,13,7.5,5.506,5.506,0,0,1,7.5,13Z"/>
                    <GeometryDrawing Brush="#FFc50b17" Geometry="F1M8.207,7.5l2.4,2.4L9.9,10.6l-2.4-2.4L5.1,10.6,4.4,9.9l2.4-2.4L4.4,5.1,5.1,4.4l2.4,2.4L9.9,4.4,10.6,5.1Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="IconWarning" Stretch="Uniform">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1A996f00" Geometry="F1M14,14.5H1L7.5,2Z"/>
                    <GeometryDrawing Brush="#FF996f00" Geometry="F1M7.944,1.77H7.056l-6.5,12.5L1,15H14l.444-.73ZM1.824,14,7.5,3.084,13.176,14Z"/>
                    <GeometryDrawing Brush="#FF996f00" Geometry="F1M7.5,13.25a.75.75,0,1,1,.75-.75A.75.75,0,0,1,7.5,13.25ZM7,6v4.5H8V6Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="IconInformation" Stretch="Uniform">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1A005dba" Geometry="F1M13.5,7.5a6,6,0,1,1-6-6A6,6,0,0,1,13.5,7.5Z"/>
                    <GeometryDrawing Brush="#FF005dba" Geometry="F1M7.5,1A6.5,6.5,0,1,0,14,7.5,6.508,6.508,0,0,0,7.5,1Zm0,12A5.5,5.5,0,1,1,13,7.5,5.506,5.506,0,0,1,7.5,13Z"/>
                    <GeometryDrawing Brush="#FF005dba" Geometry="F1M8,11V6H7v5Zm.25-6.5a.75.75,0,1,1-.75-.75A.75.75,0,0,1,8.25,4.5Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="IconQuestion" Stretch="Uniform">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1A005dba" Geometry="F1M13.5,7.5a6,6,0,1,1-6-6A6,6,0,0,1,13.5,7.5Z"/>
                    <GeometryDrawing Brush="#FF005dba" Geometry="F1M7.5,1A6.5,6.5,0,1,0,14,7.5,6.508,6.508,0,0,0,7.5,1Zm0,12A5.5,5.5,0,1,1,13,7.5,5.506,5.506,0,0,1,7.5,13Z"/>
                    <GeometryDrawing Brush="#FF005dba" Geometry="F1M7.5,3.781A2.205,2.205,0,0,1,9.688,5.969c0,1.054-.7,1.5-1.3,2.115a1.518,1.518,0,0,0-.454,1.385H7.062a2.814,2.814,0,0,1,.13-1.153,2.794,2.794,0,0,1,.746-1,3.581,3.581,0,0,0,.745-.83,1.275,1.275,0,0,0-.67-1.729,1.313,1.313,0,0,0-1.825,1.21H5.312A2.195,2.195,0,0,1,7.5,3.781ZM8.25,11.5a.75.75,0,1,1-.75-.75A.75.75,0,0,1,8.25,11.5Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Rectangle x:Name="IconRect" Grid.Column="0"
                       Width="32" Height="32" Margin="0,0,14,0"
                       VerticalAlignment="Top" HorizontalAlignment="Left"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="MessageText" Grid.Column="1"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel x:Name="ButtonPanel" Grid.Row="1"
                    HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="ButtonLeft" MinWidth="75" Padding="14,5"
                    Visibility="Collapsed" Margin="0,0,6,0" Click="OnLeftClick"/>
            <Button x:Name="ButtonMiddle" MinWidth="75" Padding="14,5"
                    Visibility="Collapsed" Margin="0,0,6,0" Click="OnMiddleClick"/>
            <Button x:Name="ButtonRight" MinWidth="75" Padding="14,5"
                    Click="OnRightClick"/>
        </StackPanel>
    </Grid>
</Window>
