            <Trigger Property="HasDropShadow" SourceName="PART_Popup" Value="true">
                <Setter Property="Margin" TargetName="shadow" Value="0"/>
                <Setter Property="Color" TargetName="shadow" Value="Transparent"/>
            </Trigger>
