            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Areopag.DisabledBg}"/>
                <Setter Property="Foreground" Value="{StaticResource Areopag.DisabledFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

