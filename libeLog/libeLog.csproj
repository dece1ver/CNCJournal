<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>AddForm.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="AddForm.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Fonts\JetBrainsMono-Bold.ttf" />
    <None Remove="Resources\Fonts\JetBrainsMono-Medium.ttf" />
    <None Remove="Resources\Fonts\JetBrainsMono-Regular.ttf" />
    <None Remove="Resources\Fonts\JetBrainsMono-SemiBold.ttf" />
    <None Remove="Resources\Fonts\GolosText-Bold.ttf" />
    <None Remove="Resources\Fonts\GolosText-Medium.ttf" />
    <None Remove="Resources\Fonts\GolosText-Regular.ttf" />
    <None Remove="Resources\Fonts\GolosText-SemiBold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\JetBrainsMono-Bold.ttf" />
