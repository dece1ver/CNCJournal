    <Resource Include="Resources\Fonts\JetBrainsMono-Regular.ttf" />
    <Resource Include="Resources\Fonts\JetBrainsMono-SemiBold.ttf" />
    <Resource Include="Resources\Fonts\GolosText-Bold.ttf" />
